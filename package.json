{
  "name": "robyrew-id",
  "private": true,
  "version": "0.1.0",
  "description": "RobyRew ID: the one @handle and avatar across RobyRew apps, written to Logto",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4345",
    "dev:local": "node ./scripts/dev-local.mjs",
    "build": "npm run check && astro build",
    "preview": "node ./server.mjs",
    "start": "node ./server.mjs",
    "check": "astro sync && tsc --noEmit && node scripts/astro-check.mjs",
    "test": "vitest run",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@logto/node": "^4.0.2",
    "@robyrew/astro-logto": "github:RobyRew/astro-logto#v0.2.0",
    "@robyrew/web-config": "github:RobyRew/web-config#v0.4.0",
    "astro": "^7.4.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.17.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
