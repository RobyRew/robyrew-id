# Public origin of this app (redirect URIs and avatar URLs are built from it).
PUBLIC_SITE_URL=https://id.robyrew.com

LOGTO_ENDPOINT=https://auth.robyrew.com

# Logto application "RobyRew ID": Traditional Web, first-party.
#   Redirect URI:             https://id.robyrew.com/api/auth/callback
#   Post sign-out redirect:   https://id.robyrew.com/
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Seals the server-side session rows: openssl rand -base64 32
LOGTO_COOKIE_SECRET=

# Logto application "RobyRew ID (management)": Machine-to-machine, with the
# role "Logto Management API access". Writes username, avatar and customData.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
LOGTO_MANAGEMENT_RESOURCE=https://default.logto.app/api

# Signing key of this app's webhook (Console → Webhooks), endpoint
# https://id.robyrew.com/api/hooks/logto, events: User.Created,
# User.Data.Updated, User.Deleted, User.SuspensionStatus.Updated.
LOGTO_WEBHOOK_SIGNING_KEY=

# SQLite + avatars. In production: the named volume robyrew-id-data on /app/data.
DATA_DIR=/app/data
